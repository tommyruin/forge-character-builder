{
  "description": "Exact places where a denylisted term is a persisted or interoperability contract rather than residue. Each entry names the file, the permitted pattern, and why it is permitted.",
  "entries": [
    {
      "path": "packages/engine/src/character/service.ts",
      "pattern": "Aurora - https://www\\.aurorabuilder\\.com",
      "reason": "the exporter header other .dnd5e readers key on"
    },
    {
      "path": "packages/engine/src/testing/dnd5e-samples.ts",
      "pattern": "Aurora - https://www\\.aurorabuilder\\.com",
      "reason": "byte-exact sample of the exporter header"
    },
    {
      "path": "packages/engine/src/dnd5e/document.test.ts",
      "pattern": "aurorabuilder\\.com",
      "reason": "asserts the exporter header round-trips byte-exact"
    },
    {
      "path": "packages/engine/src/content/proxies.ts",
      "pattern": "Aurora Legacy Essentials",
      "reason": "content-source display name whose proxy prefix is baked into element ids"
    },
    {
      "path": "packages/engine/src/worker-handlers.test.ts",
      "pattern": "ID_SOURCE_AURORA_LEGACY_ESSENTIALS",
      "reason": "element id from the corpus"
    },
    {
      "path": "scripts/fetch-corpus.mjs",
      "pattern": "AuroraLegacy",
      "reason": "the public corpus repository's name and download URL"
    },
    {
      "path": "third-party/elements/provenance.md",
      "pattern": "AuroraLegacy",
      "reason": "provenance record of the public corpus"
    },
    {
      "path": "third-party/elements/testdata.provenance.json",
      "pattern": "AuroraLegacy",
      "reason": "provenance record of the public corpus"
    },
    {
      "path": "third-party/srd-5.2/provenance.md",
      "pattern": "AuroraLegacy",
      "reason": "provenance record of the public corpus"
    },
    {
      "path": "scripts/audit/denylist-terms.json",
      "pattern": ".*",
      "reason": "the denylist itself"
    },
    {
      "path": "scripts/audit/allowlist.json",
      "pattern": ".*",
      "reason": "the allowlist itself"
    },
    {
      "path": "scripts/audit-public-tree.mjs",
      "pattern": ".*",
      "reason": "the audit itself"
    },
    {
      "path": "NOTICE.md",
      "pattern": "AuroraLegacy",
      "reason": "attribution of the public corpus"
    },
    {
      "path": ".gitattributes",
      "pattern": ".*",
      "reason": "no residue; listed so the file is documented"
    },
    {
      "path": "packages/engine/src/content/core-baseline.test.ts",
      "pattern": "Builder\\\\.Presentation\\|aurora",
      "reason": "the test that keeps those names out of the core baseline"
    },
    {
      "path": "README.md",
      "pattern": "buymeacoffee\\.com/tommyruin3w",
      "reason": "the project's own support link, shown in the app, the README and the GitHub funding file"
    }
  ]
}
