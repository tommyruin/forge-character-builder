			<div element="ID_WOTC_PHB_CLASS_FEATURE_ROGUE_UNCANNY_DODGE"/>
			<div element="ID_WOTC_PHB_CLASS_FEATURE_ROGUE_EVASION"/>
			<div element="ID_WOTC_PHB_CLASS_FEATURE_ROGUE_RELIABLETALENT"/>
			<div element="ID_WOTC_PHB_CLASS_FEATURE_ROGUE_BLINDSENSE"/>
			<div element="ID_WOTC_PHB_CLASS_FEATURE_ROGUE_SLIPPERYMIND"/>
			<div element="ID_WOTC_PHB_CLASS_FEATURE_ROGUE_ELUSIVE"/>
