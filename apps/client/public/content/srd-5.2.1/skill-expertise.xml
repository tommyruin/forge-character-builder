<?xml version="1.0" encoding="utf-8" ?>
<!--
	Authored expertise elements for the shipped baseline.

	The 2024 classes and feats grant Expertise with
	`<select type="Proficiency" supports="Skill Expertise">` (Bard, Rogue,
	Ranger, the Skilled-style feats), and the 2024 Wizard names the elements
	below by id. The shipped 2014 expertise elements are a different type
	("Class Feature", supports "Expertise, Skill"), so none of those selects
	had a candidate against the bundled content.

	These are purely mechanical: each one requires proficiency in its skill
	and doubles the proficiency bonus for that skill. The id scheme follows
	the vendored corpus (core/ALE.xml) so the corpus's own references resolve
	unchanged; the elements themselves are authored here.
-->
<elements>
	<element name="Skill Expertise (Acrobatics)" type="Proficiency" source="Internal" id="ID_INTERNAL_PROFICIENCY_SKILL_EXPERTISE_ACROBATICS">
		<supports>Expertise, Skill Expertise, ID_INTERNAL_SUPPORT_EXPERTISE</supports>
		<requirements>ID_PROFICIENCY_SKILL_ACROBATICS</requirements>
		<description>
			<p>Your proficiency bonus is doubled for any Acrobatics check you make.</p>
		</description>
		<sheet display="false" />
		<rules>
			<stat name="acrobatics:proficiency" value="proficiency" bonus="double" />
		</rules>
	</element>
